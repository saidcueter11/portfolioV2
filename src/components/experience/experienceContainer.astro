---
import { LocationIcon } from '../icons/LocationIcon'

interface Props {
  period: string
  role: string
  company: string
  location: string
  description: string[]
  technologies: string[]
}

const { period, role, company, location, description, technologies } =
  Astro.props
---

<article class="font-bricolage group relative overflow-hidden rounded-2xl border border-dark-green/15 bg-white/20 p-6 backdrop-blur-sm transition-all duration-300 hover:bg-white/30 hover:shadow-lg hover:shadow-dark-green/10 sm:p-7">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/65 to-transparent"></div>

  <div class="flex flex-col gap-5">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div class="max-w-3xl">
        <span class="inline-flex rounded-full bg-accent/15 px-3 py-1 text-xs font-semibold tracking-wide text-accent-hover border border-accent/25">
          {period}
        </span>

        <h3 class="mt-4 text-2xl font-bold leading-tight text-dark-green sm:text-3xl">
          {role}
        </h3>

        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-medium text-ligth-green sm:text-base">
          <span class="inline-flex rounded-full bg-white/35 px-3 py-1 font-semibold text-dark-green/90 shadow-sm shadow-dark-green/5">
            {company}
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/35 px-3 py-1 shadow-sm shadow-dark-green/5">
            <LocationIcon />
            {location}
          </span>
        </div>
      </div>
    </div>

    <div class="h-px w-full bg-dark-green/10"></div>

    <ul class="ml-5 max-w-3xl list-disc space-y-3 text-sm leading-relaxed text-ligth-green marker:text-accent-hover sm:text-base">
      {description.map((text) => <li>{text}</li>)}
    </ul>

    <div class="flex flex-wrap gap-2 text-xs font-semibold">
      {
        technologies.map((tech) => (
          <span class="cursor-default rounded-md border border-accent/35 bg-accent/15 px-2.5 py-1 text-dark-green shadow-sm transition-all hover:bg-accent/25">
            {tech}
          </span>
        ))
      }
    </div>
  </div>
</article>
