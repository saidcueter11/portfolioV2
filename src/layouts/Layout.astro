---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import { NavBar } from '../components/header/NavBar'
import { InstagramIcon } from '../components/icons/InstagramIcon'
import { GitHubIcon } from '../components/icons/GithubIcon'
import { LinkedInIcon } from '../components/icons/LinkedInIcon'
import AvatarHeader from '../components/header/AvatarHeader.astro'
import SideMenuMain from '../components/SideMenuMain.astro'

interface Props {
  headerTitle?: string
  seoTitle?: string
  seoDescription?: string
  seoImage?: string
  type?: 'website' | 'article'
}

const SITE = 'https://scueter.com'
const DEFAULT_TITLE = 'Said Cueter — Frontend Developer'
const DEFAULT_DESCRIPTION =
  'Frontend developer specializing in React, Astro, and TypeScript. Explore my projects, experience, and get in touch.'
const DEFAULT_IMAGE = `${SITE}/thumbnail.jpeg`

const currentPath = Astro.url.pathname
const {
  headerTitle = '',
  seoTitle = DEFAULT_TITLE,
  seoDescription = DEFAULT_DESCRIPTION,
  seoImage = DEFAULT_IMAGE,
  type = 'website',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, SITE).href
---

<!doctype html>
<html
  lang="en"
  class="bg-gradient-to-b from-ligth-accent via-[#d4d6da] to-[#cfd2d7]"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <title>{seoTitle}</title>

    <!-- Primary Meta -->
    <meta name="title" content={seoTitle} />
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Said Cueter" />
    <meta
      name="keywords"
      content="Said Cueter, Frontend Developer, React, Astro, TypeScript, TailwindCSS, Web Developer, Portfolio"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:site_name" content="Said Cueter" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${SITE}/#website`,
          url: SITE,
          name: "Said Cueter",
          description: DEFAULT_DESCRIPTION,
          inLanguage: "en-US",
        },
        {
          "@type": "Person",
          "@id": `${SITE}/#person`,
          name: "Said Cueter",
          url: SITE,
          jobTitle: "Frontend Developer",
          sameAs: [
            "https://github.com/saidcueter11",
            "https://www.linkedin.com/in/said-cueter/",
          ],
          knowsAbout: [
            "React",
            "Astro",
            "TypeScript",
            "TailwindCSS",
            "Frontend Development",
          ],
        },
        {
          "@type": "WebPage",
          "@id": canonicalURL,
          url: canonicalURL,
          name: seoTitle,
          description: seoDescription,
          isPartOf: { "@id": `${SITE}/#website` },
          about: { "@id": `${SITE}/#person` },
          inLanguage: "en-US",
        },
      ],
    })} />

    <ClientRouter />
  </head>

  <body class="relative min-h-dvh w-full flex flex-col">
    <NavBar client:visible currentPath={currentPath} headerTitle={headerTitle}>
      <AvatarHeader />
    </NavBar>
    <div class="flex flex-col p-6 my-18 max-w-7xl mx-auto w-full">
      <SideMenuMain orientation="left">
        <li>
          <GitHubIcon
            href="https://github.com/saidcueter11"
            fill="fill-dark-green"
            hoverFill="fill-accent"
          />
        </li>
        <li>
          <InstagramIcon />
        </li>
        <li>
          <LinkedInIcon />
        </li>
      </SideMenuMain>
      <slot />
      <SideMenuMain orientation="right">
        <a
          href="mailto:saidcueter11@gmail.com"
          class="[writing-mode:vertical-lr] cursor-pointer font-bricolage tracking-widest text-sm text-dark-green hover:text-accent transition-all duration-300 hover:-translate-y-1"
          >saidcueter11@gmail.com</a
        >
      </SideMenuMain>
    </div>
  </body>
</html>
